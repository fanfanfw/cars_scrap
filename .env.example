# Logging
LOG_LEVEL=INFO

# Listing URLs (override via CLI --start-url)
MUDAHMY_CARS_LISTING_URL=
CARLIST_CARS_LISTING_URL=
MOBIL123_CARS_LISTING_URL=https://www.mobil123.com/mobil-bekas-dijual/indonesia?sort=modification_date_search.desc
CARMUDI_CARS_LISTING_URL=https://www.carmudi.co.id/mobil-bekas-dijual/indonesia?sort=modification_date_search.desc

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_NAME_MOBIL123_CARS=
DB_NAME_CARMUDI_CARS=
DB_USER=
DB_PASSWORD=
DB_BATCH_SIZE=100

# Botasaurus runtime
BOTASAURUS_PROFILE=
BOTASAURUS_TINY_PROFILE=true
BOTASAURUS_BYPASS_CLOUDFLARE=true
BOTASAURUS_HUMAN_MODE=true
BOTASAURUS_CLOSE_ON_CRASH=true
BOTASAURUS_PROMPT_ON_CLOUDFLARE=false
BOTASAURUS_SAVE_HTML_ON_EMPTY=false
BOTASAURUS_ENABLE_XVFB_VIRTUAL_DISPLAY=false
BOTASAURUS_LISTING_WAIT_SECONDS=8
BOTASAURUS_DETAIL_WAIT_SECONDS=12
BOTASAURUS_POLL_INTERVAL_SECONDS=0.25

# carlist Cloudflare fallback
CARLIST_AUTO_ATTEMPT_CLOUDFLARE=true
CARLIST_CLOUDFLARE_MAX_ATTEMPTS=2
CARLIST_CLOUDFLARE_POST_SOLVE_WAIT_SECONDS=4
CARLIST_HTTP_400_RETRY_ENABLED=true
CARLIST_HTTP_400_MAX_RETRIES=2
CARLIST_RUN_MAX_ATTEMPTS=1
CARLIST_RUN_RETRY_WAIT_SECONDS=5

# mobil123 Cloudflare fallback
MOBIL123_AUTO_ATTEMPT_CLOUDFLARE=true
MOBIL123_CLOUDFLARE_MAX_ATTEMPTS=2
MOBIL123_CLOUDFLARE_POST_SOLVE_WAIT_SECONDS=4
MOBIL123_STICKY_BROWSER_RETRIES=1
MOBIL123_STICKY_BROWSER_RETRY_WAIT_SECONDS=2.5
MOBIL123_HTTP_400_RETRY_ENABLED=true
MOBIL123_HTTP_400_MAX_RETRIES=2
MOBIL123_RUN_MAX_ATTEMPTS=2
MOBIL123_RUN_RETRY_WAIT_SECONDS=5
MOBIL123_DETAIL_CIRCUIT_BREAKER_ENABLED=true
MOBIL123_DETAIL_CIRCUIT_BREAKER_MIN_SAMPLES=5
MOBIL123_DETAIL_CIRCUIT_BREAKER_ERROR_RATE=0.7
MOBIL123_DETAIL_CIRCUIT_BREAKER_CONSECUTIVE_ERRORS=4

# carmudi Cloudflare fallback
CARMUDI_AUTO_ATTEMPT_CLOUDFLARE=true
CARMUDI_CLOUDFLARE_MAX_ATTEMPTS=2
CARMUDI_CLOUDFLARE_POST_SOLVE_WAIT_SECONDS=4
CARMUDI_STICKY_BROWSER_RETRIES=1
CARMUDI_STICKY_BROWSER_RETRY_WAIT_SECONDS=2.5
CARMUDI_HTTP_400_RETRY_ENABLED=true
CARMUDI_HTTP_400_MAX_RETRIES=2
CARMUDI_RUN_MAX_ATTEMPTS=2
CARMUDI_RUN_RETRY_WAIT_SECONDS=5
CARMUDI_DETAIL_CIRCUIT_BREAKER_ENABLED=true
CARMUDI_DETAIL_CIRCUIT_BREAKER_MIN_SAMPLES=5
CARMUDI_DETAIL_CIRCUIT_BREAKER_ERROR_RATE=0.7
CARMUDI_DETAIL_CIRCUIT_BREAKER_CONSECUTIVE_ERRORS=4

# mudah.my browser/proxy error retry
MUDAHMY_BROWSER_ERROR_RETRY_ENABLED=true
MUDAHMY_BROWSER_ERROR_MAX_RETRIES=2

# Proxy (reserved - wiring can be added when needed)
PROXY_ENABLED=false
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
